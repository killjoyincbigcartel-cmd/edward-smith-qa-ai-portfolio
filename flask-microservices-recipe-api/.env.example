# Gateway -> service addresses
USERS_SERVICE_URL=http://localhost:5001
RECIPES_SERVICE_URL=http://localhost:5002

# Set this to the same secret value that recipes_service validates as
# INTERNAL_SERVICE_TOKEN. Never commit the real token.
RECIPES_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Per-upstream request timeout in seconds
UPSTREAM_TIMEOUT=1.5
