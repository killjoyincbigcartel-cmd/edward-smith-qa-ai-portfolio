# Shared signing secret: users issues JWTs; recipes validates them.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXP_MINUTES=60

# Separate database files; do not commit them.
USERS_DATABASE_URL=sqlite:///users.db
RECIPES_DATABASE_URL=sqlite:///recipes.db

# Internal service-to-service credential. Use the same value for gateway and recipes.
INTERNAL_SERVICE_TOKEN=replace-with-a-different-long-random-internal-token
RECIPES_INTERNAL_TOKEN=replace-with-a-different-long-random-internal-token

USERS_SERVICE_URL=http://localhost:5001
RECIPES_SERVICE_URL=http://localhost:5002
UPSTREAM_TIMEOUT=1.5
